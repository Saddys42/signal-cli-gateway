# signal-cli daemon (JSON-RPC TCP). With docker-compose these are set for you.
SG_SIGNAL_CLI_HOST=127.0.0.1
SG_SIGNAL_CLI_PORT=7583

# HTTP API
SG_PORT=8000
# REQUIRED outside localhost: clients send it as header X-API-Key
SG_API_KEY=change-me-to-a-long-random-string

# Optional: also POST every incoming event to this URL (HMAC-signed if secret set)
SG_WEBHOOK_URL=
SG_WEBHOOK_SECRET=

# Anti-abuse (per account). Signal bans bulk-like behaviour: keep conservative.
SG_SEND_MIN_INTERVAL_SECONDS=1.0
SG_SEND_BURST_PER_MINUTE=20
